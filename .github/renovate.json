{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Group all Jekyll package minor and patch updates together",
      "groupName": "Jekyll non-major dependencies",
      "matchManagers": [
        "bundler"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "labels": [
        "dependencies",
        "renovate",
        "jekyll"
      ],
      "matchPackageNames": [
        "/^jekyll/"
      ]
    },
    {
      "description": "Group and automerge non-major GitHub Actions updates",
      "groupName": "GitHub Actions non-major dependencies",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "labels": [
        "dependencies",
        "renovate",
        "ci"
      ]
    }
  ],
  "suppressNotifications": [
    "prIgnoreNotification",
    "prEditedNotification",
    "branchAutomergeFailure"
  ]
}
